# Neon connection string. Vercel Marketplace integrations usually provide it.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Generate with: openssl rand -hex 32
CONFIG_ENCRYPTION_KEY=replace-with-64-random-hex-characters

# Set both as Vercel Sensitive Environment Variables. Do not commit real values.
ADMIN_PASSWORD=choose-a-long-unique-password
# Generate with: openssl rand -base64 48
SESSION_SECRET=replace-with-a-random-session-signing-secret
